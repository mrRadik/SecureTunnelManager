<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SecureTunnelManager.Core\SecureTunnelManager.Core.csproj" />
    <ProjectReference Include="..\SecureTunnelManager.Data\SecureTunnelManager.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Polly" Version="8.5.2" />
    <PackageReference Include="Serilog" Version="4.1.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="SSH.NET" Version="2024.2.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\release\release-notes.txt" Link="Assets\release-notes.txt" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <ShareKeyFile>$(MSBuildThisFileDirectory)..\secrets\share-key.txt</ShareKeyFile>
    <GenerateShareKeyScript>$(MSBuildThisFileDirectory)..\build\GenerateShareKey.ps1</GenerateShareKeyScript>
    <GeneratedShareKeyFile>$(IntermediateOutputPath)ShareFileCrypto.Key.generated.cs</GeneratedShareKeyFile>
  </PropertyGroup>

  <Target Name="GenerateShareFileKey" BeforeTargets="CoreCompile">
    <ReadLinesFromFile File="$(ShareKeyFile)" Condition="Exists('$(ShareKeyFile)')">
      <Output TaskParameter="Lines" ItemName="_ShareKeyLines" />
    </ReadLinesFromFile>

    <PropertyGroup>
      <ShareEncryptionKey Condition="'$(STM_SHARE_ENCRYPTION_KEY)' != ''">$(STM_SHARE_ENCRYPTION_KEY)</ShareEncryptionKey>
      <ShareEncryptionKey Condition="'$(ShareEncryptionKey)' == '' and '@(_ShareKeyLines)' != ''">@(_ShareKeyLines)</ShareEncryptionKey>
    </PropertyGroup>

    <Error
      Condition="'$(ShareEncryptionKey)' == '' and !Exists('$(ShareKeyFile)')"
      Text="Share encryption key is missing. Set STM_SHARE_ENCRYPTION_KEY or create secrets/share-key.txt (see secrets/share-key.example.txt)." />
    <Error
      Condition="'$(ShareEncryptionKey)' == '' and Exists('$(ShareKeyFile)')"
      Text="Share encryption key file is empty: $(ShareKeyFile)" />

    <Exec
      Condition="'$(ShareEncryptionKey)' != ''"
      Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(GenerateShareKeyScript)&quot; -OutputPath &quot;$(GeneratedShareKeyFile)&quot; -Key &quot;$(ShareEncryptionKey)&quot;" />
    <Exec
      Condition="'$(ShareEncryptionKey)' == '' and Exists('$(ShareKeyFile)')"
      Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(GenerateShareKeyScript)&quot; -OutputPath &quot;$(GeneratedShareKeyFile)&quot; -KeyFile &quot;$(ShareKeyFile)&quot;" />

    <ItemGroup>
      <Compile Include="$(GeneratedShareKeyFile)" />
      <FileWrites Include="$(GeneratedShareKeyFile)" />
    </ItemGroup>
  </Target>

</Project>
