<UserControl x:Class="SecureTunnelManager.UI.Views.Controls.ShareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SecureTunnelManager.UI.Views.Controls"
             xmlns:loc="clr-namespace:SecureTunnelManager.UI.Localization"
             xmlns:vm="clr-namespace:SecureTunnelManager.UI.ViewModels"
             Background="Transparent">

    <UserControl.Resources>
        <DataTemplate x:Key="ShareItemTemplate" DataType="{x:Type vm:ShareConnectionItemViewModel}">
            <CheckBox IsChecked="{Binding IsSelected}"
                      Style="{DynamicResource StmCheckBox}"
                      Margin="0,4">
                <StackPanel>
                    <TextBlock Text="{Binding Name}" Style="{DynamicResource StmBody}"/>
                    <TextBlock Text="{Binding Subtitle}"
                               Style="{DynamicResource StmNotificationMetaText}"
                               Visibility="{Binding HasSubtitle, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </CheckBox>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Style="{DynamicResource StmPageLayout}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0">
            <controls:PageHeader.PrimaryActions>
                <StackPanel>
                    <TextBlock Text="{loc:Loc Share.Title}" Style="{DynamicResource StmPageTitle}"/>
                    <TextBlock Text="{loc:Loc Share.Subtitle}"
                               Style="{DynamicResource StmPageSubtitle}"
                               TextWrapping="Wrap"
                               MaxWidth="640"/>
                </StackPanel>
            </controls:PageHeader.PrimaryActions>
            <controls:PageHeader.SecondaryActions>
                <StackPanel Orientation="Horizontal">
                    <Button Content="{loc:Loc Share.ExportButton}"
                            Command="{Binding ExportCommand}"
                            Style="{DynamicResource StmPrimaryButton}"
                            Margin="0,0,8,0"
                            Visibility="{Binding IsExportMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Button Content="{loc:Loc Share.ImportButton}"
                            Command="{Binding ImportCommand}"
                            Style="{DynamicResource StmPrimaryButton}"
                            Visibility="{Binding IsExportMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                </StackPanel>
            </controls:PageHeader.SecondaryActions>
        </controls:PageHeader>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="{DynamicResource StmPageHeaderMargin}">
            <RadioButton Content="{loc:Loc Share.ExportTab}"
                         GroupName="ShareMode"
                         IsChecked="{Binding IsExportMode, Mode=TwoWay}"
                         Style="{DynamicResource StmRadioButton}"
                         Margin="0,0,16,0"/>
            <RadioButton Content="{loc:Loc Share.ImportTab}"
                         GroupName="ShareMode"
                         IsChecked="{Binding IsImportMode, Mode=TwoWay}"
                         Style="{DynamicResource StmRadioButton}"/>
        </StackPanel>

        <Border Grid.Row="2"
                Margin="{DynamicResource StmPageHeaderMargin}"
                Style="{DynamicResource StmCard}"
                Padding="16"
                Visibility="{Binding IsExportMode, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <StackPanel Visibility="{Binding HasExportItems, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <TextBlock Text="{loc:Loc Share.NoConnections}"
                               Style="{DynamicResource StmEmptyStateText}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <DockPanel Visibility="{Binding HasExportItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock DockPanel.Dock="Top"
                               Text="{loc:Loc Share.ExportHint}"
                               Style="{DynamicResource StmBody}"
                               Margin="0,0,0,12"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="{Binding ExportTunnelSectionTitle}"
                                               Style="{DynamicResource StmLabel}"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="{loc:Loc Share.SelectAll}"
                                                Command="{Binding SelectAllExportTunnelsCommand}"
                                                Style="{DynamicResource StmNotificationActionLink}"/>
                                        <Button Content="{loc:Loc Share.ClearSelection}"
                                                Command="{Binding ClearExportTunnelsSelectionCommand}"
                                                Style="{DynamicResource StmNotificationActionLink}"
                                                Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding ExportTunnelItems}"
                                              ItemTemplate="{StaticResource ShareItemTemplate}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="{Binding ExportRdpSectionTitle}"
                                               Style="{DynamicResource StmLabel}"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="{loc:Loc Share.SelectAll}"
                                                Command="{Binding SelectAllExportRdpCommand}"
                                                Style="{DynamicResource StmNotificationActionLink}"/>
                                        <Button Content="{loc:Loc Share.ClearSelection}"
                                                Command="{Binding ClearExportRdpSelectionCommand}"
                                                Style="{DynamicResource StmNotificationActionLink}"
                                                Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding ExportRdpItems}"
                                              ItemTemplate="{StaticResource ShareItemTemplate}"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Margin="{DynamicResource StmPageHeaderMargin}"
                Style="{DynamicResource StmCard}"
                Padding="16"
                Visibility="{Binding IsExportMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <Grid>
                <StackPanel Visibility="{Binding HasImportPreview, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <TextBlock Text="{loc:Loc Share.ImportNoFile}"
                               Style="{DynamicResource StmEmptyStateText}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,0,0,16"/>
                    <Button Content="{loc:Loc Share.Browse}"
                            Command="{Binding BrowseImportCommand}"
                            Style="{DynamicResource StmSecondaryButton}"
                            MinWidth="120"
                            HorizontalAlignment="Center"/>
                </StackPanel>

                <DockPanel Visibility="{Binding HasImportPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="{loc:Loc Share.Browse}"
                                    Command="{Binding BrowseImportCommand}"
                                    Style="{DynamicResource StmSecondaryButton}"
                                    MinWidth="120"/>
                            <TextBlock Text="{Binding ImportFileName}"
                                       Style="{DynamicResource StmBody}"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0"
                                       Opacity="0.75"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ImportSummary}"
                                   Style="{DynamicResource StmBody}"
                                   Opacity="0.85"/>
                        <TextBlock Text="{loc:Loc Share.ImportHint}"
                                   Style="{DynamicResource StmBody}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="{Binding ImportTunnelSectionTitle}"
                                               Style="{DynamicResource StmLabel}"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="{loc:Loc Share.SelectAll}"
                                                Command="{Binding SelectAllImportTunnelsCommand}"
                                                Style="{DynamicResource StmNotificationActionLink}"/>
                                        <Button Content="{loc:Loc Share.ClearSelection}"
                                                Command="{Binding ClearImportTunnelsSelectionCommand}"
                                                Style="{DynamicResource StmNotificationActionLink}"
                                                Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding ImportTunnelItems}"
                                              ItemTemplate="{StaticResource ShareItemTemplate}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="{Binding ImportRdpSectionTitle}"
                                               Style="{DynamicResource StmLabel}"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="{loc:Loc Share.SelectAll}"
                                                Command="{Binding SelectAllImportRdpCommand}"
                                                Style="{DynamicResource StmNotificationActionLink}"/>
                                        <Button Content="{loc:Loc Share.ClearSelection}"
                                                Command="{Binding ClearImportRdpSelectionCommand}"
                                                Style="{DynamicResource StmNotificationActionLink}"
                                                Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding ImportRdpItems}"
                                              ItemTemplate="{StaticResource ShareItemTemplate}"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
