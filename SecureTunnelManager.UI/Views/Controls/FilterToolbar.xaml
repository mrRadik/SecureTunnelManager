<UserControl x:Class="SecureTunnelManager.UI.Views.Controls.FilterToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="{DynamicResource StmFilterToolbarMargin}">

    <Border Style="{DynamicResource StmPageToolbar}">
        <Grid VerticalAlignment="Center" MinHeight="{DynamicResource StmControlHeight}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ContentPresenter Grid.Column="0"
                              Content="{Binding SearchContent, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Stretch"
                              Margin="0,0,4,0"/>

            <Border Grid.Column="1" Style="{DynamicResource StmToolbarDivider}"/>

            <ContentPresenter Grid.Column="2"
                              Content="{Binding FilterContent, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Right"
                              Margin="4,0,0,0"/>
        </Grid>
    </Border>
</UserControl>
