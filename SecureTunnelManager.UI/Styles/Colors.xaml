<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="StmBackgroundColor">#1C1E24</Color>
    <Color x:Key="StmSurfaceColor">#23262E</Color>
    <Color x:Key="StmCardColor">#2A2D38</Color>
    <Color x:Key="StmSidebarColor">#23262E</Color>
    <Color x:Key="StmTextPrimaryColor">#FFFFFF</Color>
    <Color x:Key="StmTextSecondaryColor">#B0B4C0</Color>
    <Color x:Key="StmAccentColor">#0078D4</Color>
    <Color x:Key="StmAccentHoverColor">#1A86D9</Color>
    <Color x:Key="StmAccentSubtleColor">#1A0078D4</Color>
    <Color x:Key="StmSuccessColor">#107C10</Color>
    <Color x:Key="StmSuccessHoverColor">#0E6B0E</Color>
    <Color x:Key="StmErrorColor">#F1707B</Color>
    <Color x:Key="StmDestructiveColor">#C42B1C</Color>
    <Color x:Key="StmDestructiveHoverColor">#A52618</Color>
    <Color x:Key="StmBorderColor">#383C48</Color>
    <Color x:Key="StmHoverColor">#30343E</Color>
    <Color x:Key="StmSelectedColor">#0C3A5E</Color>
    <Color x:Key="StmDisabledTextColor">#6A7080</Color>
    <Color x:Key="StmDisabledBackgroundColor">#282C34</Color>
    <Color x:Key="StmWarningColor">#CA5010</Color>
    <Color x:Key="StmScrollbarThumbColor">#55FFFFFF</Color>
    <Color x:Key="StmScrollbarThumbHoverColor">#80FFFFFF</Color>
    <Color x:Key="StmScrollbarThumbPressedColor">#0078D4</Color>

    <SolidColorBrush x:Key="StmBackgroundBrush" Color="{DynamicResource StmBackgroundColor}"/>
    <SolidColorBrush x:Key="StmSurfaceBrush" Color="{DynamicResource StmSurfaceColor}"/>
    <SolidColorBrush x:Key="StmCardBrush" Color="{DynamicResource StmCardColor}"/>
    <SolidColorBrush x:Key="StmSidebarBrush" Color="{DynamicResource StmSidebarColor}"/>
    <SolidColorBrush x:Key="StmTextPrimaryBrush" Color="{DynamicResource StmTextPrimaryColor}"/>
    <SolidColorBrush x:Key="StmTextSecondaryBrush" Color="{DynamicResource StmTextSecondaryColor}"/>
    <SolidColorBrush x:Key="StmAccentBrush" Color="{DynamicResource StmAccentColor}"/>
    <SolidColorBrush x:Key="StmAccentHoverBrush" Color="{DynamicResource StmAccentHoverColor}"/>
    <SolidColorBrush x:Key="StmAccentSubtleBrush" Color="{DynamicResource StmAccentSubtleColor}"/>
    <SolidColorBrush x:Key="StmSuccessBrush" Color="{DynamicResource StmSuccessColor}"/>
    <SolidColorBrush x:Key="StmSuccessHoverBrush" Color="{DynamicResource StmSuccessHoverColor}"/>
    <SolidColorBrush x:Key="StmErrorBrush" Color="{DynamicResource StmErrorColor}"/>
    <SolidColorBrush x:Key="StmDestructiveBrush" Color="{DynamicResource StmDestructiveColor}"/>
    <SolidColorBrush x:Key="StmDestructiveHoverBrush" Color="{DynamicResource StmDestructiveHoverColor}"/>
    <SolidColorBrush x:Key="StmBorderBrush" Color="{DynamicResource StmBorderColor}"/>
    <SolidColorBrush x:Key="StmHoverBrush" Color="{DynamicResource StmHoverColor}"/>
    <SolidColorBrush x:Key="StmSelectedBrush" Color="{DynamicResource StmSelectedColor}"/>
    <SolidColorBrush x:Key="StmDisabledTextBrush" Color="{DynamicResource StmDisabledTextColor}"/>
    <SolidColorBrush x:Key="StmDisabledBackgroundBrush" Color="{DynamicResource StmDisabledBackgroundColor}"/>
    <SolidColorBrush x:Key="StmWarningBrush" Color="{DynamicResource StmWarningColor}"/>
    <SolidColorBrush x:Key="StmScrollbarThumbBrush" Color="{DynamicResource StmScrollbarThumbColor}"/>
    <SolidColorBrush x:Key="StmScrollbarThumbHoverBrush" Color="{DynamicResource StmScrollbarThumbHoverColor}"/>
    <SolidColorBrush x:Key="StmScrollbarThumbPressedBrush" Color="{DynamicResource StmScrollbarThumbPressedColor}"/>

</ResourceDictionary>
