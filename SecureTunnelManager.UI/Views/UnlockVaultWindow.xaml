<windows:StmChromeWindow x:Class="SecureTunnelManager.UI.Views.UnlockVaultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SecureTunnelManager.UI.Views.Controls"
        xmlns:loc="clr-namespace:SecureTunnelManager.UI.Localization"
        xmlns:windows="clr-namespace:SecureTunnelManager.UI.Windows"
        Title="{loc:Loc Vault.UnlockTitle}"
        Style="{DynamicResource StmDialogWindow}"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="OnPreviewKeyDown">

    <windows:StmChromeWindow.Resources>
        <Style x:Key="StmVaultFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource StmFontBase}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource StmTextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="StmVaultHint" TargetType="TextBlock" BasedOn="{StaticResource StmFontBase}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource StmTextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="16"/>
            <Setter Property="Opacity" Value="0.85"/>
        </Style>

        <Style x:Key="StmVaultDivider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource StmBorderBrush}"/>
            <Setter Property="Opacity" Value="0.55"/>
            <Setter Property="Margin" Value="0,22,0,0"/>
        </Style>

        <Style x:Key="StmVaultDestructiveButton" TargetType="Button" BasedOn="{StaticResource StmGhostButton}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource StmDestructiveBrush}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource StmHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StmVaultPrimaryButton" TargetType="Button" BasedOn="{StaticResource StmPrimaryButton}">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </windows:StmChromeWindow.Resources>

    <Grid Background="{DynamicResource StmBackgroundBrush}"
          SnapsToDevicePixels="True"
          UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:WindowTitleBar Grid.Row="0" LocKey="Vault.UnlockTitle" ShowMaximizeButton="False"/>

        <!-- Unlock mode -->
        <StackPanel Grid.Row="1"
                    Margin="24,20,24,22"
                    Visibility="{Binding IsUnlockMode, Converter={StaticResource BooleanToVisibilityConverter}}">

            <Border Width="32"
                    Height="32"
                    CornerRadius="16"
                    BorderBrush="{DynamicResource StmAccentBrush}"
                    BorderThickness="1.5"
                    Background="Transparent"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,10">
                <TextBlock Text="&#xE72E;"
                           Style="{DynamicResource StmIconGlyph}"
                           FontSize="14"
                           Foreground="{DynamicResource StmAccentBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <TextBlock Text="{loc:Loc Vault.UnlockTitle}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,0,0,4"/>
            <TextBlock Text="{loc:Loc Vault.UnlockSubtitle}"
                       FontSize="13"
                       Foreground="{DynamicResource StmTextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,22"/>

            <TextBlock Text="{loc:Loc Vault.MasterPassword}" Style="{DynamicResource StmVaultFieldLabel}"/>
            <controls:RevealPasswordBox x:Name="MasterPasswordBox"
                                        HorizontalAlignment="Stretch"
                                        Password="{Binding MasterPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ShowSavedPasswordMask="{Binding ShowSavedPasswordMask, Mode=TwoWay}"/>

            <CheckBox Content="{loc:Loc Vault.RememberOnThisDevice}"
                      IsChecked="{Binding RememberOnThisDevice, Mode=TwoWay}"
                      Style="{DynamicResource StmSettingsCheckBox}"
                      FontSize="13"
                      Margin="0,10,0,0"/>

            <TextBlock Text="{Binding ErrorMessage}"
                       Style="{DynamicResource StmValidationError}"
                       FontSize="12"
                       Margin="0,8,0,0"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>

            <Border Style="{DynamicResource StmVaultDivider}"/>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0"
                        Grid.Column="0"
                        Command="{Binding RequestResetVaultCommand}"
                        Style="{DynamicResource StmVaultDestructiveButton}"
                        Padding="0,4"
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;"
                                   Style="{DynamicResource StmIconGlyph}"
                                   FontSize="12"
                                   Foreground="{DynamicResource StmDestructiveBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc Vault.ResetVault}"
                                   FontSize="13"
                                   Foreground="{DynamicResource StmDestructiveBrush}"
                                   VerticalAlignment="Center"
                                   Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="{loc:Loc Vault.ResetVaultHint}"
                           Style="{DynamicResource StmVaultHint}"
                           Margin="0,4,16,0"/>

                <Button Grid.Row="0"
                        Grid.Column="1"
                        Content="{loc:Loc Vault.Unlock}"
                        Command="{Binding UnlockCommand}"
                        IsDefault="True"
                        Style="{DynamicResource StmVaultPrimaryButton}"
                        Margin="16,0,0,0"
                        VerticalAlignment="Top"/>
            </Grid>
        </StackPanel>

        <!-- Reset confirmation -->
        <StackPanel Grid.Row="1"
                    Margin="24,20,24,22"
                    Visibility="{Binding IsConfirmResetMode, Converter={StaticResource BooleanToVisibilityConverter}}">

            <TextBlock Text="{loc:Loc Vault.ResetConfirmTitle}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12"/>
            <TextBlock Text="{loc:Loc Vault.ResetConfirmBody}"
                       FontSize="13"
                       Foreground="{DynamicResource StmTextSecondaryBrush}"
                       TextWrapping="Wrap"
                       LineHeight="20"/>

            <Border Style="{DynamicResource StmVaultDivider}"/>

            <Grid Margin="0,16,0,0">
                <Button Content="{loc:Loc Vault.Back}"
                        Command="{Binding CancelResetConfirmCommand}"
                        Style="{DynamicResource StmGhostButton}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Padding="0,4"
                        FontSize="13"/>
                <Button Content="{loc:Loc Vault.ResetVault}"
                        Command="{Binding ConfirmResetVaultCommand}"
                        Style="{DynamicResource StmDestructiveButton}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        MinHeight="36"
                        MinWidth="96"
                        Padding="16,6"
                        FontSize="13"/>
            </Grid>
        </StackPanel>

        <!-- New master password (after reset confirm) -->
        <StackPanel Grid.Row="1"
                    Margin="24,20,24,22"
                    Visibility="{Binding IsResetMode, Converter={StaticResource BooleanToVisibilityConverter}}">

            <TextBlock Text="{loc:Loc Vault.CreateNewTitle}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"/>
            <TextBlock Text="{loc:Loc Vault.ResetVaultHint}"
                       FontSize="13"
                       Foreground="{DynamicResource StmTextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,18"/>

            <TextBlock Text="{loc:Loc Vault.NewMasterPassword}" Style="{DynamicResource StmVaultFieldLabel}"/>
            <controls:RevealPasswordBox x:Name="NewMasterPasswordBox"
                                        HorizontalAlignment="Stretch"
                                        Password="{Binding NewMasterPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="{loc:Loc Vault.ConfirmNewPassword}"
                       Style="{DynamicResource StmVaultFieldLabel}"
                       Margin="0,10,0,6"/>
            <controls:RevealPasswordBox Password="{Binding ConfirmNewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        HorizontalAlignment="Stretch"/>

            <TextBlock Text="{Binding ErrorMessage}"
                       Style="{DynamicResource StmValidationError}"
                       FontSize="12"
                       Margin="0,8,0,0"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>

            <Border Style="{DynamicResource StmVaultDivider}"/>

            <Grid Margin="0,16,0,0">
                <Button Content="{loc:Loc Vault.Back}"
                        Command="{Binding BackToUnlockCommand}"
                        Style="{DynamicResource StmGhostButton}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Padding="0,4"
                        FontSize="13"/>
                <Button Content="{loc:Loc Vault.ResetVault}"
                        Command="{Binding ResetVaultCommand}"
                        Style="{DynamicResource StmDestructiveButton}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        MinHeight="36"
                        MinWidth="96"
                        Padding="16,6"
                        FontSize="13"/>
            </Grid>
        </StackPanel>
    </Grid>
</windows:StmChromeWindow>
