<UserControl x:Class="SecureTunnelManager.UI.Views.Controls.RdpStatusBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <UserControl.Resources>
        <Storyboard x:Key="PulseStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="StatusDot"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0.35" Duration="0:0:0.75" AutoReverse="True"/>
        </Storyboard>
    </UserControl.Resources>

    <Border x:Name="BadgeBorder" Style="{DynamicResource StmStatusBadgeBorder}">
        <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="StatusDot" Style="{DynamicResource StmStatusDot}"/>
            <TextBlock x:Name="StatusLabel" Style="{DynamicResource StmStatusBadgeLabel}"/>
        </StackPanel>
    </Border>
</UserControl>
