<windows:StmChromeWindow x:Class="SecureTunnelManager.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SecureTunnelManager.UI.Views.Controls"
        xmlns:vm="clr-namespace:SecureTunnelManager.UI.ViewModels"
        xmlns:loc="clr-namespace:SecureTunnelManager.UI.Localization"
        xmlns:windows="clr-namespace:SecureTunnelManager.UI.Windows"
        Title="{loc:Loc App.Title}"
        Style="{DynamicResource StmMainWindow}"
        Width="1200"
        Height="760"
        WindowStartupLocation="CenterScreen">

    <Grid Background="{DynamicResource StmBackgroundBrush}" SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:WindowTitleBar Grid.Row="0" LocKey="App.Title"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource StmSidebarBrush}"
                    BorderBrush="{DynamicResource StmBorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="14,10,14,3">
                        <TextBlock Text="{loc:Loc App.Title}"
                                   Style="{DynamicResource StmSidebarAppTitle}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="{loc:Loc Nav.Connections}" Style="{DynamicResource StmNavSectionHeader}"/>
                        <controls:NavigationItem IconGlyph="&#xE774;"
                                                 LocKey="Nav.Tunnels"
                                                 Section="{x:Static vm:NavigationSection.Tunnels}"/>
                        <controls:NavigationItem IconGlyph="&#xE7F8;"
                                                 LocKey="Nav.Rdp"
                                                 Section="{x:Static vm:NavigationSection.Rdp}"/>

                        <TextBlock Text="{loc:Loc Nav.System}" Style="{DynamicResource StmNavSectionHeader}"/>
                        <Button Command="{Binding OpenShareWizardCommand}"
                                Style="{DynamicResource StmSidebarMenuButton}"
                                Margin="4,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72D;"
                                           Style="{DynamicResource StmIconGlyph}"
                                           FontSize="16"
                                           Width="20"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc Nav.Share}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <controls:NavigationItem IconGlyph="&#xE713;"
                                                 LocKey="Nav.Settings"
                                                 Section="{x:Static vm:NavigationSection.Settings}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Background="{DynamicResource StmBackgroundBrush}">
                <controls:TunnelsView DataContext="{Binding}"
                    Visibility="{Binding SelectedSection, Converter={StaticResource NavigationSectionVisibilityConverter}, ConverterParameter=Tunnels}"/>
                <controls:RdpView DataContext="{Binding Rdp}"
                    Visibility="{Binding DataContext.SelectedSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NavigationSectionVisibilityConverter}, ConverterParameter=Rdp}"/>
                <controls:SettingsView DataContext="{Binding}"
                    Visibility="{Binding SelectedSection, Converter={StaticResource NavigationSectionVisibilityConverter}, ConverterParameter=Settings}"/>
            </Grid>
        </Grid>

        <controls:AppStatusBar Grid.Row="2"
                               NotificationCenter="{Binding Notifications}"
                               VaultStatusText="{Binding VaultStatusText}"
                               IsVaultUnlocked="{Binding IsVaultUnlocked}"
                               ActiveConnectionsText="{Binding ActiveConnectionsText}"
                               VersionText="{Binding VersionText}"
                               VaultActionText="{Binding VaultActionText}"
                               VaultActionCommand="{Binding VaultActionCommand}"
                               VaultClickCommand="{Binding VaultStatusClickCommand}"/>
    </Grid>
</windows:StmChromeWindow>
