<UserControl x:Class="SecureTunnelManager.UI.Views.Controls.RdpComputerTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Width="140"
             Margin="0,0,16,16"
             Cursor="Hand"
             MouseLeftButtonDown="OnMouseLeftButtonDown">

    <Border Style="{DynamicResource StmRdpComputerTile}"
            ToolTip="{Binding ErrorTooltip}">
        <Border.ContextMenu>
            <ContextMenu Opened="OnContextMenuOpened">
                <MenuItem Tag="Connect" Click="OnConnectClick"/>
                <MenuItem Tag="Disconnect" Click="OnDisconnectClick"/>
                <Separator/>
                <MenuItem Tag="Edit" Click="OnEditClick"/>
                <MenuItem Tag="Delete" Click="OnDeleteClick"/>
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" HorizontalAlignment="Center" Margin="0,8,0,4">
                <TextBlock Text="&#xE7F8;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="40"
                           Foreground="{DynamicResource StmAccentBrush}"
                           HorizontalAlignment="Center"/>
                <Ellipse Width="10" Height="10"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Margin="0,-2,-2,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource StmStatusStoppedDotBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Connected">
                                    <Setter Property="Fill" Value="{DynamicResource StmStatusConnectedDotBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Connecting">
                                    <Setter Property="Fill" Value="{DynamicResource StmStatusReconnectingDotBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Error">
                                    <Setter Property="Fill" Value="{DynamicResource StmStatusErrorDotBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
            </Grid>

            <TextBlock Grid.Row="1"
                       Text="{Binding Name}"
                       FontWeight="SemiBold"
                       FontSize="13"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="4,4,4,2"/>

            <TextBlock Grid.Row="2"
                       Text="{Binding RdpHostDisplay}"
                       Style="{DynamicResource StmPageSubtitle}"
                       FontSize="11"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="4,0,4,2"/>

            <TextBlock Grid.Row="3"
                       Text="{Binding StatusText}"
                       FontSize="11"
                       Foreground="{DynamicResource StmTextSecondaryBrush}"
                       TextAlignment="Center"
                       Margin="4,0,4,8"/>
        </Grid>
    </Border>
</UserControl>
