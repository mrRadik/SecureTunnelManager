<UserControl x:Class="SecureTunnelManager.UI.Views.Controls.ConnectionRouteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <Grid>
        <!-- Compact horizontal route for tunnel cards -->
        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsCompact, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Style="{DynamicResource StmRouteHopPill}">
                <TextBlock Text="{Binding LocalEndpoint, ElementName=Root}" Style="{DynamicResource StmRouteHopText}"/>
            </Border>

            <ItemsControl ItemsSource="{Binding JumpHostDisplays, ElementName=Root}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{DynamicResource StmRouteChainArrow}"/>
                            <Border Style="{DynamicResource StmRouteHopPill}">
                                <TextBlock Text="{Binding}" Style="{DynamicResource StmRouteHopText}"/>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{DynamicResource StmRouteChainArrow}"/>
            <Border Style="{DynamicResource StmRouteHopPill}">
                <TextBlock Text="{Binding DestinationDisplay, ElementName=Root}" Style="{DynamicResource StmRouteHopText}"/>
            </Border>
        </StackPanel>

        <!-- Vertical route for wizard / detail -->
        <StackPanel Visibility="{Binding IsCompact, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
            <TextBlock Text="{Binding LocalEndpoint, ElementName=Root}"
                       FontFamily="Consolas" FontSize="13"
                       Foreground="{DynamicResource StmTextPrimaryBrush}"/>

            <ItemsControl ItemsSource="{Binding JumpHostDisplays, ElementName=Root}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="&#x2192;" FontFamily="Segoe UI" FontSize="11"
                                       Foreground="{DynamicResource StmRouteConnectorBrush}" Margin="4,2,0,2"/>
                            <TextBlock Text="{Binding}" FontFamily="Segoe UI" FontSize="13"
                                       Foreground="{DynamicResource StmTextSecondaryBrush}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="&#x2192;" FontFamily="Segoe UI" FontSize="11"
                       Foreground="{DynamicResource StmRouteConnectorBrush}" Margin="4,2,0,2"/>
            <TextBlock Text="{Binding DestinationDisplay, ElementName=Root}"
                       FontFamily="Consolas" FontSize="13"
                       Foreground="{DynamicResource StmTextPrimaryBrush}"/>
        </StackPanel>
    </Grid>
</UserControl>
