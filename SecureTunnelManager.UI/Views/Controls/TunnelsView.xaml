<UserControl x:Class="SecureTunnelManager.UI.Views.Controls.TunnelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SecureTunnelManager.UI.ViewModels"
             xmlns:controls="clr-namespace:SecureTunnelManager.UI.Views.Controls"
             xmlns:loc="clr-namespace:SecureTunnelManager.UI.Localization"
             Background="Transparent">

    <UserControl.Resources>
        <ContextMenu x:Key="TunnelsGlobalMenu"
                     Style="{DynamicResource StmContextMenu}">
            <MenuItem Header="{loc:Loc Tunnels.GlobalMenu.StartAll}"
                      Command="{Binding StartAllCommand}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE768;"
                               FontFamily="{StaticResource StmIconFontFamily}"
                               FontSize="12"
                               Foreground="{DynamicResource StmStatusConnectedDotBrush}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{loc:Loc Tunnels.GlobalMenu.StopAll}"
                      Command="{Binding StopAllCommand}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE71A;"
                               FontFamily="{StaticResource StmIconFontFamily}"
                               FontSize="12"
                               Foreground="{DynamicResource StmDestructiveBrush}"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator Style="{StaticResource StmMenuSeparator}"/>
            <MenuItem Header="{loc:Loc Tunnels.GlobalMenu.RestartAll}"
                      Command="{Binding RestartAllCommand}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE777;"
                               FontFamily="{StaticResource StmIconFontFamily}"
                               FontSize="12"
                               Foreground="{DynamicResource StmStatusReconnectingDotBrush}"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>

    <Grid Style="{DynamicResource StmPageLayout}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Compact stats row -->
        <Grid Grid.Row="0" Style="{DynamicResource StmPageStatsRow}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <controls:SummaryStats Grid.Column="0" VerticalAlignment="Center">
                <controls:SummaryStatItem Count="{Binding TotalTunnelCount, Mode=OneWay}"
                                          Label="{Binding TotalSummary, Mode=OneWay}"
                                          ShowSymbol="False"
                                          IsEmphasized="True"/>
                <controls:SummaryStatItem Count="{Binding ConnectedCount, Mode=OneWay}"
                                          Label="{Binding ConnectedSummary, Mode=OneWay}"
                                          SymbolBrush="{DynamicResource StmStatusConnectedDotBrush}"/>
                <controls:SummaryStatItem Count="{Binding StoppedCount, Mode=OneWay}"
                                          Label="{Binding StoppedSummary, Mode=OneWay}"
                                          Symbol="○"
                                          SymbolBrush="{DynamicResource StmStatusStoppedDotBrush}"/>
                <controls:SummaryStatItem Count="{Binding ReconnectingCount, Mode=OneWay}"
                                          Label="{Binding ReconnectingSummary, Mode=OneWay}"
                                          Symbol="↻"
                                          SymbolBrush="{DynamicResource StmStatusReconnectingDotBrush}"/>
                <controls:SummaryStatItem Count="{Binding ErrorCount, Mode=OneWay}"
                                          Label="{Binding ErrorSummary, Mode=OneWay}"
                                          Symbol="×"
                                          SymbolBrush="{DynamicResource StmStatusErrorDotBrush}"
                                          Margin="0"/>
            </controls:SummaryStats>

            <Button x:Name="GlobalMenuButton"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{DynamicResource StmOverflowMenuButton}"
                    Click="OnGlobalMenuClick"/>
        </Grid>

        <!-- Search and filters -->
        <controls:FilterToolbar Grid.Row="1">
            <controls:FilterToolbar.SearchContent>
                <controls:SearchBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                    Placeholder="{loc:Loc Tunnels.SearchPlaceholder}"/>
            </controls:FilterToolbar.SearchContent>
            <controls:FilterToolbar.FilterContent>
                <controls:SegmentedControl ItemsSource="{Binding TunnelFilterSegments}"
                                           SelectedValue="{Binding StatusFilter, Mode=TwoWay}"
                                           IsInline="True"/>
            </controls:FilterToolbar.FilterContent>
        </controls:FilterToolbar>

        <!-- Main content -->
        <Grid Grid.Row="2">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ProgressBar Style="{DynamicResource StmProgressBar}" Width="240" IsIndeterminate="True"/>
                <TextBlock Text="{loc:Loc Tunnels.Loading}" Style="{DynamicResource StmEmptyStateText}"/>
            </StackPanel>

            <controls:EmptyState VerticalAlignment="Center" HorizontalAlignment="Center"
                                 Title="{loc:Loc Tunnels.EmptyTitle}"
                                 Subtitle="{loc:Loc Tunnels.EmptySubtitle}"
                                 Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <controls:EmptyState VerticalAlignment="Center" HorizontalAlignment="Center"
                                 Title="{loc:Loc Tunnels.NoResultsTitle}"
                                 Subtitle="{loc:Loc Tunnels.NoResultsSubtitle}"
                                 Visibility="{Binding ShowNoResults, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasFilteredTunnels, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding FilteredTunnels}"
                              Margin="{StaticResource StmFabScrollPadding}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TunnelRowViewModel}">
                            <controls:TunnelCard DataContext="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Button Content="+"
                    Command="{Binding AddTunnelCommand}"
                    Style="{DynamicResource StmFabButton}"
                    ToolTip="{loc:Loc Tunnels.NewTunnelTooltip}"/>
        </Grid>
    </Grid>
</UserControl>
