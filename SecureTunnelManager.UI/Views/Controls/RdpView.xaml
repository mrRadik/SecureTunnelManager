<UserControl x:Class="SecureTunnelManager.UI.Views.Controls.RdpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SecureTunnelManager.UI.Views.Controls"
             xmlns:loc="clr-namespace:SecureTunnelManager.UI.Localization"
             Background="Transparent">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Button Content="{loc:Loc Rdp.NewComputer}"
                        Command="{Binding AddComputerCommand}"
                        Style="{DynamicResource StmPrimaryButton}"
                        Margin="0,0,8,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusSummary}"
                           Style="{DynamicResource StmBody}"
                           Foreground="{DynamicResource StmTextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"/>
                <TextBox Width="220"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource StmInput}"
                         Margin="0"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1"
                   Text="{loc:Loc Rdp.Subtitle}"
                   Style="{DynamicResource StmPageSubtitle}"
                   Margin="0,0,0,16"/>

        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ShowEmptyState, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding FilteredComputers}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:RdpComputerTile/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Style="{DynamicResource StmCard}" Margin="0"
                    Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                    <TextBlock Text="&#xE7F8;" Style="{DynamicResource StmIconGlyph}" FontSize="40"
                               Foreground="{DynamicResource StmAccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="{loc:Loc Rdp.EmptyTitle}" Style="{DynamicResource StmEmptyStateTitle}"/>
                    <TextBlock Text="{loc:Loc Rdp.EmptyText}" Style="{DynamicResource StmEmptyStateText}" MaxWidth="420"/>
                    <Button Content="{loc:Loc Rdp.NewComputer}"
                            Command="{Binding AddComputerCommand}"
                            Style="{DynamicResource StmPrimaryButton}"
                            HorizontalAlignment="Center"
                            Margin="0,16,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource StmCard}" Margin="0"
                    Visibility="{Binding ShowNoResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                    <TextBlock Text="{loc:Loc Rdp.NoResultsTitle}" Style="{DynamicResource StmEmptyStateTitle}"/>
                    <TextBlock Text="{loc:Loc Rdp.NoResultsText}" Style="{DynamicResource StmEmptyStateText}" MaxWidth="360"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
