<UserControl x:Class="SecureTunnelManager.UI.Views.Controls.EmptyState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="{Binding IconGlyph, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   FontSize="36"
                   Foreground="{DynamicResource StmTextSecondaryBrush}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,12"
                   Opacity="0.6">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource StmIconGlyph}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowIcon, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Style="{DynamicResource StmEmptyStateTitle}"/>

        <TextBlock Text="{Binding Subtitle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Style="{DynamicResource StmEmptyStateText}"
                   MaxWidth="420"/>

        <ContentPresenter Content="{Binding ActionContent, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          HorizontalAlignment="Center"
                          Margin="0,16,0,0"/>
    </StackPanel>
</UserControl>
