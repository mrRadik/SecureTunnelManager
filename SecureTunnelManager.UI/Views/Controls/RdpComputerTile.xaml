<UserControl x:Class="SecureTunnelManager.UI.Views.Controls.RdpComputerTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SecureTunnelManager.UI.Views.Controls"
             xmlns:vm="clr-namespace:SecureTunnelManager.UI.ViewModels"
             xmlns:loc="clr-namespace:SecureTunnelManager.UI.Localization"
             xmlns:icons="clr-namespace:SecureTunnelManager.Core.ServiceIcons;assembly=SecureTunnelManager.Core"
             x:Name="Root"
             Cursor="Hand"
             MouseLeftButtonDown="OnMouseLeftButtonDown">

    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.ViewMode, RelativeSource={RelativeSource AncestorType=controls:RdpView}}"
                             Value="{x:Static vm:RdpViewMode.Grid}">
                    <Setter Property="Margin" Value="0,0,16,16"/>
                    <Setter Property="Width" Value="236"/>
                    <Setter Property="HorizontalAlignment" Value="Left"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <Border x:Name="CardBorder"
            Focusable="True"
            ToolTip="{Binding TileTooltip}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource StmCardBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource StmBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="{StaticResource StmCardCornerRadius}"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="MinHeight" Value="52"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding DataContext.ViewMode, RelativeSource={RelativeSource AncestorType=controls:RdpView}}"
                                 Value="{x:Static vm:RdpViewMode.Grid}">
                        <Setter Property="Padding" Value="16"/>
                        <Setter Property="MinHeight" Value="0"/>
                        <Setter Property="CornerRadius" Value="{StaticResource StmRdpCardCornerRadius}"/>
                    </DataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding DataContext.ViewMode, RelativeSource={RelativeSource AncestorType=controls:RdpView}}"
                                       Value="{x:Static vm:RdpViewMode.Grid}"/>
                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="{DynamicResource StmCardHoverBrush}"/>
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding DataContext.ViewMode, RelativeSource={RelativeSource AncestorType=controls:RdpView}}"
                                       Value="{x:Static vm:RdpViewMode.List}"/>
                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="{DynamicResource StmHoverBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource StmAccentBrush}"/>
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding DataContext.ViewMode, RelativeSource={RelativeSource AncestorType=controls:RdpView}}"
                                       Value="{x:Static vm:RdpViewMode.Grid}"/>
                            <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="True"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="BorderBrush" Value="{DynamicResource StmAccentBrush}"/>
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding DataContext.ViewMode, RelativeSource={RelativeSource AncestorType=controls:RdpView}}"
                                       Value="{x:Static vm:RdpViewMode.List}"/>
                            <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="True"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="BorderBrush" Value="{DynamicResource StmAccentBrush}"/>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Border.ContextMenu>
            <ContextMenu Opened="OnContextMenuOpened">
                <MenuItem Tag="Connect" Click="OnConnectClick"/>
                <MenuItem Tag="Disconnect" Click="OnDisconnectClick"/>
                <Separator/>
                <MenuItem Tag="MoveToGroup" Click="OnMoveToGroupClick"/>
                <MenuItem Tag="Edit" Click="OnEditClick"/>
                <MenuItem Tag="Delete" Click="OnDeleteClick"/>
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
        <!-- List view -->
        <Grid Visibility="{Binding DataContext.ViewMode, RelativeSource={RelativeSource AncestorType=controls:RdpView}, Converter={StaticResource NavigationSectionVisibilityConverter}, ConverterParameter=List}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1.2*" MinWidth="100" MaxWidth="200"/>
                <ColumnDefinition Width="2.8*" MinWidth="140"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <controls:ServiceIconBadge Grid.Column="0"
                                       IconKey="{Binding IconKey}"
                                       FallbackKey="{x:Static icons:ServiceIconCatalog.DefaultRdpKey}"
                                       Margin="0,0,12,0"
                                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="{Binding Name}" Style="{DynamicResource StmCardTitleText}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Description}"
                           Style="{DynamicResource StmCardSecondaryText}"
                           TextTrimming="CharacterEllipsis"
                           MinHeight="18"/>
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                <Border Style="{DynamicResource StmRouteHopPill}" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding RdpHostDisplay}" Style="{DynamicResource StmRouteHopText}"/>
                </Border>
            </StackPanel>

            <controls:RdpStatusBadge Grid.Column="3" Status="{Binding Status}" VerticalAlignment="Center" Margin="0,0,8,0"/>

            <Button Grid.Column="4"
                    Content="&#xE712;"
                    Style="{DynamicResource StmCardMenuButton}"
                    VerticalAlignment="Center"
                    Click="OnMenuClick"/>
        </Grid>

        <!-- Grid view -->
        <Grid Visibility="{Binding DataContext.ViewMode, RelativeSource={RelativeSource AncestorType=controls:RdpView}, Converter={StaticResource NavigationSectionVisibilityConverter}, ConverterParameter=Grid}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="0"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <controls:ServiceIconBadge Grid.Column="0"
                                           IconKey="{Binding IconKey}"
                                           FallbackKey="{x:Static icons:ServiceIconCatalog.DefaultRdpKey}"
                                           IsCompact="True"
                                           VerticalAlignment="Top"
                                           Margin="0,0,8,0"/>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            MinWidth="0"
                            Margin="0,0,8,0">
                    <TextBlock Text="{Binding Name}"
                               Style="{DynamicResource StmRdpGridCardTitle}"
                               HorizontalAlignment="Stretch"
                               TextTrimming="CharacterEllipsis"/>

                    <TextBlock Text="{Binding Description}"
                               Style="{DynamicResource StmRdpGridCardDescription}"
                               HorizontalAlignment="Stretch"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,4,0,0"/>

                    <TextBlock Text="{Binding RdpHostDisplay}"
                               Style="{DynamicResource StmRdpGridCardCaption}"
                               HorizontalAlignment="Stretch"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Top">
                    <controls:RdpStatusBadge Status="{Binding Status}"
                                             IsCompact="True"
                                             VerticalAlignment="Center"
                                             Margin="0,0,4,0"/>
                    <Button Content="&#xE712;"
                            Style="{DynamicResource StmRdpCardMenuButtonCompact}"
                            VerticalAlignment="Top"
                            Click="OnMenuClick"/>
                </StackPanel>
            </Grid>

            <Button Grid.Row="1"
                    Style="{DynamicResource StmRdpGridConnectButton}"
                    Command="{Binding DataContext.Rdp.ConnectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    Visibility="{Binding CanConnect, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid HorizontalAlignment="Stretch">
                    <TextBlock Text="{loc:Loc Rdp.Menu.Connect}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="&#xE72A;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,4,0"/>
                </Grid>
            </Button>

            <Button Grid.Row="1"
                    Style="{DynamicResource StmRdpGridDisconnectButton}"
                    Command="{Binding DataContext.Rdp.DisconnectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    Content="{loc:Loc Rdp.Menu.Disconnect}"
                    Visibility="{Binding CanDisconnect, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>
        </Grid>
    </Border>
</UserControl>
