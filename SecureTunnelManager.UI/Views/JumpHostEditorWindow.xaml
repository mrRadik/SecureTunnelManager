<windows:StmChromeWindow x:Class="SecureTunnelManager.UI.Views.JumpHostEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SecureTunnelManager.UI.Views.Controls"
        xmlns:windows="clr-namespace:SecureTunnelManager.UI.Windows"
        xmlns:loc="clr-namespace:SecureTunnelManager.UI.Localization"
        Title="{Binding WindowTitle}"
        Style="{DynamicResource StmDialogWindow}"
        Width="520"
        Height="620"
        WindowStartupLocation="CenterOwner">

    <Grid Background="{DynamicResource StmBackgroundBrush}"
          SnapsToDevicePixels="True"
          UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:WindowTitleBar Grid.Row="0" Title="{Binding WindowTitle}" ShowMaximizeButton="False"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="24,20">
            <StackPanel>
                <TextBlock Text="{loc:Loc JumpHost.Editor.Intro}" Style="{DynamicResource StmPageSubtitle}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                <TextBlock Text="{loc:Loc Editor.Name}" Style="{DynamicResource StmLabel}"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource StmInput}"/>
                <TextBlock Text="{Binding NameError}" Style="{DynamicResource StmValidationError}"
                           Visibility="{Binding NameError, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="{loc:Loc Editor.HostAddress}" Style="{DynamicResource StmLabel}"/>
                        <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource StmInput}"/>
                        <TextBlock Text="{Binding HostError}" Style="{DynamicResource StmValidationError}"
                                   Visibility="{Binding HostError, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{loc:Loc Editor.Port}" Style="{DynamicResource StmLabel}"/>
                        <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource StmInput}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{loc:Loc Editor.SignInName}" Style="{DynamicResource StmLabel}" Margin="0,12,0,0"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource StmInput}"/>
                <TextBlock Text="{Binding UsernameError}" Style="{DynamicResource StmValidationError}"
                           Visibility="{Binding UsernameError, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>

                <TextBlock Text="{loc:Loc Editor.SignInMethod}" Style="{DynamicResource StmLabel}" Margin="0,16,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <RadioButton Content="{loc:Loc Editor.Password}"
                                 Style="{DynamicResource StmRadioButton}"
                                 IsChecked="{Binding IsPasswordAuth, Mode=TwoWay}"/>
                    <RadioButton Content="{loc:Loc Editor.CertificateKeyFile}"
                                 Style="{DynamicResource StmRadioButton}"
                                 IsChecked="{Binding IsPrivateKeyAuth, Mode=TwoWay}"/>
                </StackPanel>

                <StackPanel Visibility="{Binding IsPasswordAuth, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{loc:Loc Editor.Password}" Style="{DynamicResource StmLabel}"/>
                    <PasswordBox x:Name="PasswordBox" Style="{DynamicResource StmInputPassword}" PasswordChanged="OnPasswordChanged"/>
                    <TextBlock Text="{loc:Loc Editor.KeepPasswordHint}"
                               Style="{DynamicResource StmPageSubtitle}"
                               Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding CredentialError}" Style="{DynamicResource StmValidationError}"
                               Visibility="{Binding CredentialError, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                </StackPanel>

                <StackPanel Visibility="{Binding IsPrivateKeyAuth, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{loc:Loc Editor.KeyFile}" Style="{DynamicResource StmLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding PrivateKeyPath, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource StmInput}"/>
                        <Button Grid.Column="1" Content="{loc:Loc Share.Browse}" Command="{Binding BrowseKeyCommand}" Style="{DynamicResource StmSecondaryButton}" Margin="8,0,0,4" MinWidth="90"/>
                    </Grid>
                    <TextBlock Text="{Binding PrivateKeyError}" Style="{DynamicResource StmValidationError}"
                               Visibility="{Binding PrivateKeyError, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                    <TextBlock Text="{loc:Loc Editor.KeyPassphraseOptional}" Style="{DynamicResource StmLabel}"/>
                    <PasswordBox x:Name="KeyPassphraseBox" Style="{DynamicResource StmInputPassword}" PasswordChanged="OnKeyPassphraseChanged"/>
                </StackPanel>

                <TextBlock Text="{Binding ErrorMessage}" Style="{DynamicResource StmValidationError}" Margin="0,12,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{DynamicResource StmDialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:Loc Common.Cancel}" Command="{Binding CancelCommand}" Style="{DynamicResource StmGhostButton}" Margin="0,0,8,0"/>
                <Button Content="{loc:Loc Common.Save}" Command="{Binding SaveCommand}" Style="{DynamicResource StmPrimaryButton}"/>
            </StackPanel>
        </Border>
    </Grid>
</windows:StmChromeWindow>
