<UserControl x:Class="SecureTunnelManager.UI.Views.Controls.ConnectionPathNode"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <Grid x:Name="NodeRoot" Margin="0,0,0,32">
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsLast, ElementName=Root}" Value="True">
                        <Setter Property="Margin" Value="0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="32"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Width="32" VerticalAlignment="Top">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Width="28" Height="28">
                <Border CornerRadius="14"
                        BorderBrush="{Binding AccentBrush, ElementName=Root}"
                        BorderThickness="1.5"
                        Background="Transparent"/>
                <TextBlock Text="{Binding IconGlyph, ElementName=Root}"
                           Style="{DynamicResource StmIconGlyph}"
                           FontSize="12"
                           Foreground="{Binding AccentBrush, ElementName=Root}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
            <Border Width="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,30,0,0"
                    Height="32"
                    Background="{DynamicResource StmBorderBrush}"
                    Opacity="0.45"
                    Visibility="{Binding ShowConnector, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>

        <StackPanel Grid.Column="1"
                    Margin="10,2,0,0"
                    VerticalAlignment="Top">
            <TextBlock Text="{Binding Label, ElementName=Root}"
                       FontSize="12"
                       Foreground="{DynamicResource StmTextSecondaryBrush}"/>
            <TextBlock Text="{Binding Value, ElementName=Root}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Margin="0,2,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource StmFontBase}">
                        <Setter Property="FontFamily" Value="Segoe UI"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding UseMonospace, ElementName=Root}" Value="True">
                                <Setter Property="FontFamily" Value="Consolas"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
