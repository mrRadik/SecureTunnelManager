<windows:StmChromeWindow x:Class="SecureTunnelManager.UI.Views.GroupPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SecureTunnelManager.UI.Views.Controls"
        xmlns:windows="clr-namespace:SecureTunnelManager.UI.Windows"
        Style="{DynamicResource StmDialogWindow}"
        Width="440"
        Height="280"
        WindowStartupLocation="CenterOwner">

    <Grid Background="{DynamicResource StmBackgroundBrush}"
          SnapsToDevicePixels="True"
          UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:WindowTitleBar x:Name="TitleBar" Grid.Row="0" ShowMaximizeButton="False"/>

        <StackPanel Grid.Row="1" Margin="24,20">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" Style="{DynamicResource StmBody}" Margin="0,0,0,16"/>
            <TextBlock x:Name="GroupLabel" Style="{DynamicResource StmLabel}"/>
            <ComboBox x:Name="GroupCombo"
                      Style="{DynamicResource StmComboBox}"
                      IsEditable="True"/>
        </StackPanel>

        <Border Grid.Row="2" Style="{DynamicResource StmDialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Style="{DynamicResource StmGhostButton}" Margin="0,0,8,0"/>
                <Button x:Name="OkButton" Content="OK" IsDefault="True" Click="OnOkClick" Style="{DynamicResource StmPrimaryButton}"/>
            </StackPanel>
        </Border>
    </Grid>
</windows:StmChromeWindow>
