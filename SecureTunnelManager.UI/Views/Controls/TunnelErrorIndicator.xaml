<UserControl x:Class="SecureTunnelManager.UI.Views.Controls.TunnelErrorIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Visibility="{Binding ShowErrorIndicator, RelativeSource={RelativeSource Self}, Converter={StaticResource BooleanToVisibilityConverter}}">

    <TextBlock x:Name="IndicatorGlyph"
               Text="&#xE946;"
               Style="{DynamicResource StmIconGlyph}"
               FontSize="20"
               Foreground="{DynamicResource StmStatusErrorDotBrush}"
               VerticalAlignment="Center"
               RenderTransformOrigin="0.5,0.5">
        <TextBlock.RenderTransform>
            <RotateTransform Angle="180"/>
        </TextBlock.RenderTransform>
    </TextBlock>
</UserControl>
