<UserControl x:Class="SecureTunnelManager.UI.Views.Controls.TunnelCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SecureTunnelManager.UI.Views.Controls"
             xmlns:icons="clr-namespace:SecureTunnelManager.Core.ServiceIcons;assembly=SecureTunnelManager.Core"
             x:Name="Root">

    <Border x:Name="CardBorder" Style="{DynamicResource StmTunnelCard}">
        <Border.ContextMenu>
            <ContextMenu Opened="OnContextMenuOpened"
                         Style="{DynamicResource StmContextMenu}">
                <MenuItem Tag="Start" Click="OnStartClick"/>
                <MenuItem Tag="Stop" Click="OnStopClick"/>
                <MenuItem Tag="Restart" Click="OnRestartClick"/>
                <Separator Style="{StaticResource StmMenuSeparator}"/>
                <MenuItem Tag="OpenTerminal" Click="OnOpenTerminalClick"/>
                <Separator Style="{StaticResource StmMenuSeparator}"/>
                <MenuItem Tag="Duplicate" Click="OnDuplicateClick"/>
                <MenuItem Tag="Edit" Click="OnEditClick"/>
                <MenuItem Tag="Delete" Click="OnDeleteClick"/>
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1.2*" MinWidth="100" MaxWidth="200"/>
                <ColumnDefinition Width="2.8*" MinWidth="180"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <controls:ServiceIconBadge Grid.Column="0"
                                       IconKey="{Binding IconKey}"
                                       FallbackKey="{x:Static icons:ServiceIconCatalog.DefaultTunnelKey}"
                                       Margin="0,0,12,0"
                                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="{Binding Name}" Style="{DynamicResource StmCardTitleText}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Description}"
                           Style="{DynamicResource StmCardSecondaryText}"
                           TextTrimming="CharacterEllipsis"
                           MinHeight="18"/>
            </StackPanel>

            <controls:ConnectionRouteView Grid.Column="2"
                IsCompact="True"
                LocalEndpoint="{Binding LocalEndpoint}"
                JumpHostDisplays="{Binding JumpHostDisplays}"
                DestinationDisplay="{Binding DestinationDisplay}"
                VerticalAlignment="Center"
                Margin="0,0,12,0"/>

            <controls:TunnelStatusBadge Grid.Column="3"
                Status="{Binding Status}"
                ReconnectAttempt="{Binding ReconnectAttempt}"
                VerticalAlignment="Center"
                Margin="0,0,8,0"/>

            <controls:TunnelErrorIndicator Grid.Column="4"
                ErrorText="{Binding ErrorTooltip, Mode=OneWay}"
                ShowErrorIndicator="{Binding ShowErrorIndicator, Mode=OneWay}"
                Margin="0,0,4,0"/>

            <Button Grid.Column="5"
                    x:Name="MenuButton"
                    Content="&#xE712;"
                    Style="{DynamicResource StmCardMenuButton}"
                    VerticalAlignment="Center"
                    Click="OnMenuClick"/>
        </Grid>
    </Border>
</UserControl>
